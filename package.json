{
  "name": "origami-ninja",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Origami Ninja — a 2D paper platformer",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "npm run assets && vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && npm run assets && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:seo": "node scripts/check-seo.ts",
    "assets": "node scripts/generate-assets.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
